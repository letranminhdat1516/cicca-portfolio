DATABASE_URL=postgresql://portfolio:portfolio@localhost:5432/portfolio?schema=public
# Generate a strong secret: `openssl rand -hex 32`  (MUST be >=16 chars; app refuses to start otherwise)
JWT_SECRET=replace-with-openssl-rand-hex-32
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_SITE_URL=http://localhost:3000
API_PORT=3001
# Comma-separated allowed CORS origins for the API
CORS_ORIGINS=http://localhost:3000
# Admin account seeded by `prisma db seed` (change in production)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=changeme123
# Contact form ("write me a letter", POST /contact) — sends via Resend (https://resend.com).
# Without RESEND_API_KEY the endpoint answers 503 mail_not_configured. The CONTACT_FROM
# domain must be verified in Resend.
RESEND_API_KEY=
CONTACT_FROM="Le Tran Minh Dat <hello@letranminhdat.com>"
CONTACT_TO=datltmse@gmail.com
